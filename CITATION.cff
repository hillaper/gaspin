    given-names: Perttu
    orcid: "https://orcid.org/0000-0003-4598-5395"
version: 0.1.0
license: MIT
repository-code: "https://github.com/hillaper/gaspin"
keywords:
  - molecular dynamics
  - atomic gases
  - collision events
  - van der Waals complexes
  - NMR
